# ============================================================
# Shared API keys — inherited by all installs unless overridden.
# Copy this file to _defaults.env and fill in your keys.
# _defaults.env is gitignored; this example file is tracked.
# ============================================================

# Shared AI keys (required for installs that don't provide their own)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Shared SMTP (optional — installs can override with their own)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Shared Resend API key (alternative to SMTP)
# RESEND_API_KEY=
