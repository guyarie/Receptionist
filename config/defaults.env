# ============================================================
# App-level defaults — committed to git.
# Override any of these in .env for deployment-specific needs.
# ============================================================

# Start in setup mode; set to false in .env once setup is complete
SETUP_MODE=true

# Server ports
PORT=3000
SETUP_PORT=3001

# AI models
OPENROUTER_MODEL=minimax/minimax-m2.5
SETUP_AGENT_MODEL=minimax/minimax-m2.5
POST_CALL_AGENT_MODEL=openai/gpt-4o

# Realtime voice
OPENAI_REALTIME_VOICE=alloy
REALTIME_AI_PROVIDER=openai

# Voice Activity Detection tuning
OPENAI_VAD_SILENCE_DURATION_MS=600
OPENAI_VAD_PREFIX_PADDING_MS=300

# Post-call agent mode: shadow | active | disabled
POST_CALL_AGENT_MODE=active

# Headless browser scraping
SCRAPING_MODE=puppeteer
PAGE_LOAD_TIMEOUT=10000
BROWSER_HEADLESS=true
BROWSER_DISABLE_IMAGES=true
BROWSER_DISABLE_CSS=false
MAX_RETRIES=3
RETRY_DELAY=1000
MULTI_PAGE_SCRAPING=true

# Daily digest email
DIGEST_ENABLED=false
DIGEST_SCHEDULE_HOUR=18
