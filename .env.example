BUSINESS_NAME=RTC Bellevue
OWNER_NAME=Miri Arie
RECEPTIONIST_NAME=Sunny
OWNER_PHONE=+1234567890
PUBLIC_URL=https://www.rtcbellevue.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4

# Website Configuration
# URL of your practice website (used by npm run scrape-providers)
WEBSITE_URL=https://www.yourpractice.com

# Server Configuration
# PORT: Use 443 for direct HTTPS (requires SSL certs below), or 3000 with reverse proxy
PORT=443
PUBLIC_URL=https://your-domain.com  # Your public URL for Twilio webhooks (optional, for logging)

# SSL Configuration (required for production — Twilio needs HTTPS/WSS)
# Use Let's Encrypt: certbot certonly --standalone -d yourdomain.com
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# Admin Panel Security
# Comma-separated list of IP addresses allowed to access /admin/* routes
# Leave empty to allow all IPs (not recommended for production)
# Example: ADMIN_ALLOWED_IPS=203.0.113.1,198.51.100.42
ADMIN_ALLOWED_IPS=

# Admin authentication password (required for production)
# When set, users must log in to access the admin panel
# Leave empty during development to disable authentication
ADMIN_PASSWORD=

# Session secret for signing session cookies (optional)
# If not set, ADMIN_PASSWORD will be used as the session secret
# Use a separate random string for better security
SESSION_SECRET=

# Web Chat Widget CORS
# The origin(s) (scheme + domain + optional port) of your website(s).
# Only these origins will be allowed to call /api/webchat from a browser.
# In local development, leave this unset — localhost origins are allowed automatically.
# 
# Single origin: ALLOWED_ORIGIN=https://www.yourpractice.com
# Multiple origins (comma-separated): ALLOWED_ORIGIN=https://www.yourpractice.com,https://staging.yourpractice.com,https://yourpractice.squarespace.com
ALLOWED_ORIGIN=

# Realtime Voice Streaming
# API key for OpenAI Realtime API (optional — enables real-time voice streaming for calls)
OPENAI_API_KEY=your_openai_api_key_here
# Voice for OpenAI Realtime sessions (options: alloy, echo, fable, onyx, nova, shimmer)
OPENAI_REALTIME_VOICE=alloy
# Which realtime AI provider to use (currently supported: openai)
REALTIME_AI_PROVIDER=openai

# OpenAI Realtime VAD (Voice Activity Detection) Tuning
# These control how the server detects when a caller starts/stops speaking.
# Raising silence_duration_ms reduces premature turn-endings for slow speakers.
# Raising prefix_padding_ms avoids clipping the very start of speech.
#
# Defaults (used when these variables are not set):
#   OPENAI_VAD_SILENCE_DURATION_MS=600
#   OPENAI_VAD_PREFIX_PADDING_MS=300
OPENAI_VAD_SILENCE_DURATION_MS=600
OPENAI_VAD_PREFIX_PADDING_MS=300

# Headless Browser Scraping Configuration
# Mode selection: 'puppeteer' (headless browser) or 'axios' (simple HTTP client)
SCRAPING_MODE=puppeteer

# Puppeteer-specific settings
PAGE_LOAD_TIMEOUT=10000          # Page load timeout in milliseconds
BROWSER_HEADLESS=true            # Run browser in headless mode
BROWSER_DISABLE_IMAGES=true      # Disable image loading for performance
BROWSER_DISABLE_CSS=false        # Disable CSS loading (not recommended)

# Retry settings for failed page loads
MAX_RETRIES=3                    # Maximum retry attempts for failed pages
RETRY_DELAY=1000                 # Initial retry delay in milliseconds

# Multi-page provider scraping (recommended)
# When true, visits each provider's individual page for complete information
# Benefits: detailed insurance info, better accuracy, per-provider caching
# Performance: ~40-90 seconds for 10 providers (vs ~30-60 seconds single-page)
MULTI_PAGE_SCRAPING=true

# Email Notification (SMTP) Configuration
# Required for post-call provider notifications and daily digest emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=receptionist@yourpractice.com

# Admin email for daily digest reports
ADMIN_EMAIL=admin@yourpractice.com

# Set DIGEST_ENABLED to true in order to use. Note: it was not tested yet
# Hour (0-23) to send the daily digest email (default: 18 = 6 PM)
DIGEST_ENABLED=false  
DIGEST_SCHEDULE_HOUR=18


# Post-Call Agent Mode
# shadow  — run agent in parallel with existing flow, save to shadow files (default)
# active  — agent replaces existing flow (with fallback)
# disabled — existing flow only, no agent
POST_CALL_AGENT_MODE=shadow
