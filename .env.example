# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4

# Website Configuration
# URL of your practice website (used by npm run scrape-providers)
WEBSITE_URL=https://www.yourpractice.com

# Server Configuration
# PORT: Use 443 for direct HTTPS (requires SSL certs below), or 3000 with reverse proxy
PORT=443
PUBLIC_URL=https://your-domain.com  # Your public URL for Twilio webhooks (optional, for logging)

# SSL Configuration (required for production — Twilio needs HTTPS/WSS)
# Use Let's Encrypt: certbot certonly --standalone -d yourdomain.com
# SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# Admin Panel Security
# Comma-separated list of IP addresses allowed to access /admin/* routes
# Leave empty to allow all IPs (not recommended for production)
# Example: ADMIN_ALLOWED_IPS=203.0.113.1,198.51.100.42
ADMIN_ALLOWED_IPS=

# Web Chat Widget CORS
# The origin (scheme + domain + optional port) of your Squarespace website.
# Only this origin will be allowed to call /api/webchat from a browser.
# In local development, leave this unset — localhost origins are allowed automatically.
# Example: ALLOWED_ORIGIN=https://www.yourpractice.com
ALLOWED_ORIGIN=

# Realtime Voice Streaming
# API key for OpenAI Realtime API (optional — enables real-time voice streaming for calls)
OPENAI_API_KEY=your_openai_api_key_here
# Voice for OpenAI Realtime sessions (options: alloy, echo, fable, onyx, nova, shimmer)
OPENAI_REALTIME_VOICE=alloy
# Which realtime AI provider to use (currently supported: openai)
REALTIME_AI_PROVIDER=openai

# OpenAI Realtime VAD (Voice Activity Detection) Tuning
# These control how the server detects when a caller starts/stops speaking.
# Raising silence_duration_ms reduces premature turn-endings for slow speakers.
# Raising prefix_padding_ms avoids clipping the very start of speech.
#
# Defaults (used when these variables are not set):
#   OPENAI_VAD_SILENCE_DURATION_MS=600
#   OPENAI_VAD_PREFIX_PADDING_MS=300
OPENAI_VAD_SILENCE_DURATION_MS=600
OPENAI_VAD_PREFIX_PADDING_MS=300
